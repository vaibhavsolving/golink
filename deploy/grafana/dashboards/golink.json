{
  "uid": "golink",
  "title": "golink service",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(golink_http_requests_total[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by route (seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(golink_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Responses by status code",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(golink_http_requests_total[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Links stored",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "golink_links_stored" } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [ { "refId": "A", "expr": "golink_uptime_seconds" } ]
    }
  ]
}
